{
  "name": "skyline-737",
  "version": "2.0.0",
  "private": true,
  "description": "Boeing 737-900 flight simulator over real-world North Texas geography (TypeScript + WebGL)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "node tools/build.mjs --tests && node --test \"dist-tests/*.test.mjs\"",
    "e2e": "node tools/build.mjs && node tests/e2e.mjs",
    "data:nav": "node tools/build_navdata.mjs",
    "data:terrain": "python3 tools/build_terrain.py",
    "data:weather": "python3 tools/build_weather.py",
    "artifact": "node tools/build.mjs --artifact"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@squawk/airport-data": "0.9.2",
    "@squawk/airway-data": "0.7.3",
    "@squawk/fix-data": "0.8.1",
    "@squawk/navaid-data": "0.8.2",
    "@squawk/procedure-data": "0.9.5",
    "@types/node": "22.10.2",
    "@types/three": "0.160.0",
    "esbuild": "0.24.2",
    "geomagnetism": "0.2.0",
    "typescript": "5.7.2"
  }
}
